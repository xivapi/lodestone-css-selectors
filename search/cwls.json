{
  "default": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "query": {
        "type": "object",
        "properties": {
          "q": {
            "type": "string"
          },
          "worldname": {
            "anyOf": [
              {
                "type": "string",
                "enum": [
                  "_region_1",
                  "_region_2",
                  "_region_3",
                  "_region_4"
                ]
              },
              {
                "type": "string",
                "enum": [
                  "_dc_Aether",
                  "_dc_Crystal",
                  "_dc_Dynamis",
                  "_dc_Primal",
                  "_dc_Chaos",
                  "_dc_Light",
                  "_dc_Materia",
                  "_dc_Elemental",
                  "_dc_Gaia",
                  "_dc_Mana",
                  "_dc_Meteor"
                ]
              },
              {
                "type": "string",
                "pattern": "^[A-Za-z]+$"
              }
            ]
          },
          "character_count": {
            "type": "string",
            "enum": [
              "1-10",
              "11-30",
              "31-50",
              "51-"
            ]
          },
          "cf_public": {
            "type": "boolean"
          },
          "order": {
            "type": "number",
            "minimum": 1,
            "maximum": 6
          },
          "page": {
            "type": "number",
            "minimum": 1,
            "maximum": 20
          }
        },
        "required": [
          "q"
        ],
        "additionalProperties": false
      },
      "entries": {
        "type": "object",
        "properties": {
          "total": {
            "selector": "div.parts__fraction",
            "regex": "(\\d+)",
            "type": "number"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "selector": "a",
                  "attribute": "href",
                  "regex": "lodestone\\/crossworld_linkshell\\/(\\S+)\\/",
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "selector": "div > h4"
                },
                "server": {
                  "type": "object",
                  "properties": {
                    "dc": {
                      "type": "string",
                      "selector": "li:first-of-type"
                    }
                  },
                  "required": [
                    "dc"
                  ],
                  "additionalProperties": false
                },
                "members": {
                  "type": "number",
                  "selector": "li:last-of-type > span"
                }
              },
              "required": [
                "id",
                "name",
                "server",
                "members"
              ],
              "additionalProperties": false
            },
            "selector": "div.linkshells > div"
          }
        },
        "required": [
          "total",
          "items"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "query",
      "entries"
    ],
    "additionalProperties": false
  }
}