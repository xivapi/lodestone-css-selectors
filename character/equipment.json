{
  "default": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "selector": "h1.db-view__header__detail__item-name"
      },
      "icon": {
        "type": "string",
        "format": "uri",
        "selector": "img.db-view__header__item-image--icon",
        "attribute": "src"
      },
      "category": {
        "type": "string",
        "selector": "h2.db-view__header__detail__category-name"
      },
      "ilvl": {
        "selector": "h3.db-view__item-level",
        "regex": "(?<level>\\d+)",
        "type": "number"
      },
      "equip": {
        "type": "object",
        "properties": {
          "class": {
            "selector": "div.db-view__item-equip-text p:nth-of-type(1)",
            "regex": "\\b[A-Z]{3} \\b",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "level": {
            "selector": "div.db-view__item-equip-text p:nth-of-type(2)",
            "regex": "(\\d+)",
            "type": "number"
          }
        },
        "required": [
          "class",
          "level"
        ],
        "additionalProperties": false
      },
      "attributes": {
        "type": "object",
        "properties": {
          "main": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "selector": "dt"
                },
                "value": {
                  "type": "number",
                  "selector": "dd"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            },
            "selector": "div.db-view__item-info dl.db-view__item-info__list--main-status"
          },
          "bonus": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string",
                  "selector": "span.name"
                },
                "value": {
                  "type": "number",
                  "selector": "span.value"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            },
            "selector": "div.db-view__item-info ul.db-view__item-info__list--bonuses > li"
          },
          "effect": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": {
                  "type": "string"
                },
                "value": {
                  "type": "number"
                }
              },
              "required": [
                "type",
                "value"
              ],
              "additionalProperties": false
            },
            "selector": "div.db-view__series_bonus li",
            "regex": "^(?<type>\\D+) (?<value>\\W\\d+)"
          }
        },
        "required": [
          "main",
          "bonus"
        ],
        "additionalProperties": false
      },
      "materia": {
        "selector": "div.db-view__item-info ul.character-item__materia-list > li",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {},
          "additionalProperties": false
        }
      },
      "flags": {
        "type": "object",
        "properties": {
          "repair": {
            "type": "object",
            "properties": {
              "req": {
                "selector": "div.db-view__item-info__table--craft_repair tr:nth-of-type(3) > td",
                "regex": "(?<class>\\D+) \\D+ (?<level>\\d+)",
                "type": "object",
                "properties": {
                  "class": {
                    "type": "string"
                  },
                  "level": {
                    "type": "number"
                  }
                },
                "required": [
                  "class",
                  "level"
                ],
                "additionalProperties": false
              },
              "material": {
                "type": "string",
                "selector": "div.db-view__item-info__table--craft_repair tr:nth-of-type(4) > td"
              }
            },
            "required": [
              "req",
              "material"
            ],
            "additionalProperties": false
          },
          "extractable": {
            "selector": "ul.db-view__item-info__craft_repair > li:nth-of-type(1) > span",
            "regex": "\\b(?:yes|ja|oui|はい)\\b|○",
            "type": "boolean"
          },
          "projectable": {
            "selector": "ul.db-view__item-info__craft_repair > li:nth-of-type(2) > span",
            "regex": "\\b(?:yes|ja|oui|はい)\\b|○",
            "type": "boolean"
          },
          "desynthesizable": {
            "selector": "ul.db-view__item-info__craft_repair > li:nth-of-type(3) > span",
            "regex": "\\b(?:yes|ja|oui|はい)\\b|○",
            "type": "boolean"
          },
          "dyeable": {
            "selector": "ul.db-view__item-info__craft_repair > li:nth-of-type(4) > span",
            "regex": "\\b(?:yes|ja|oui|はい)\\b|○",
            "type": "boolean"
          }
        },
        "required": [
          "repair",
          "extractable",
          "projectable",
          "desynthesizable",
          "dyeable"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "name",
      "icon",
      "category",
      "ilvl",
      "equip",
      "attributes",
      "flags"
    ],
    "additionalProperties": false
  }
}