{
  "default": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "selector": "p.frame__chara__name"
      },
      "avatar": {
        "type": "string",
        "format": "uri",
        "selector": "div.frame__chara__face > img",
        "attribute": "src"
      },
      "portrait": {
        "type": "string",
        "format": "uri",
        "selector": "div.character__detail__image img",
        "attribute": "src"
      },
      "server": {
        "selector": "p.frame__chara__world",
        "regex": "^(?<world>.+?)\\s*\\[(?<dc>.*?)\\]$",
        "type": "object",
        "properties": {
          "world": {
            "type": "string"
          },
          "dc": {
            "type": "string"
          }
        },
        "required": [
          "world",
          "dc"
        ],
        "additionalProperties": false
      },
      "title": {
        "type": "string",
        "selector": "p.frame__chara__title"
      },
      "bio": {
        "default": "-",
        "selector": "div.character__character_profile",
        "type": "string"
      },
      "identity": {
        "selector": "div.character-block:nth-child(2) p.character-block__profile",
        "regex": "^(?<race>Hyur|Elezen|Lalafell|Miqo'te|Roegadyn|Au Ra|Hrothgar|Viera)(?<clan>Midlander|Highlander|Wildwood|Duskwight|Plainsfolk|Dunesfolk|Seeker of the Sun|Keeper of the Moon|Sea Wolf|Hellsguard|Raen|Xaela|Helions|The Lost|Rava|Veena) / (?<gender>\\W)",
        "type": "object",
        "properties": {
          "race": {
            "type": "string"
          },
          "clan": {
            "type": "string"
          },
          "gender": {
            "type": "string",
            "enum": [
              "Male",
              "Female"
            ]
          }
        },
        "required": [
          "race",
          "clan",
          "gender"
        ],
        "additionalProperties": false
      },
      "nameday": {
        "type": "string",
        "selector": "p.character-block__birth"
      },
      "guardian": {
        "type": "string",
        "selector": "p.character-block__profile:nth-of-type(4)"
      },
      "citystate": {
        "type": "string",
        "selector": "div.character-block:nth-child(4) p.character-block__profile"
      },
      "grand_company": {
        "default": null,
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "name": {
                "selector": "div.character-block:nth-of-type(4) p.character-block__profile",
                "regex": "(\\D+) \\/ \\D+",
                "type": "string"
              },
              "rank": {
                "type": "object",
                "properties": {
                  "name": {
                    "selector": "div.character-block:nth-of-type(4) p.character-block__profile",
                    "regex": "\\D+ \\/ (\\D+)",
                    "type": "string"
                  },
                  "icon": {
                    "type": "string",
                    "format": "uri",
                    "selector": "div.character-block:nth-of-type(4) > img",
                    "attribute": "src"
                  }
                },
                "required": [
                  "name",
                  "icon"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "name",
              "rank"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "free_company": {
        "default": null,
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "selector": "a.entry__freecompany[href*=\"/freecompany/\"]",
                "attribute": "href",
                "regex": "lodestone\\/freecompany\\/(\\S+)\\/",
                "type": "string"
              },
              "name": {
                "type": "string",
                "selector": "a.entry__freecompany[href*=\"/freecompany/\"] div.character__freecompany__name > h4"
              },
              "crest": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "selector": "a.entry__freecompany[href*=\"/freecompany/\"] div.character__freecompany__crest__image > img",
                "attribute": "src"
              }
            },
            "required": [
              "id",
              "name",
              "crest"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "pvp_team": {
        "default": null,
        "anyOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "selector": "a.entry__freecompany[href*=\"/pvpteam/\"]",
                "attribute": "href",
                "regex": "lodestone\\/pvpteam\\/(\\S+)\\/",
                "type": "string"
              },
              "name": {
                "type": "string",
                "selector": "a.entry__freecompany[href*=\"/pvpteam/\"] div.character__freecompany__name > h4"
              },
              "crest": {
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uri"
                },
                "selector": "a.entry__freecompany[href*=\"/pvpteam/\"] div.character__freecompany__crest__image > img",
                "attribute": "src"
              }
            },
            "required": [
              "id",
              "name",
              "crest"
            ],
            "additionalProperties": false
          },
          {
            "type": "null"
          }
        ]
      },
      "stats": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "selector": "p.character__param__text"
            },
            "value": {
              "type": "number",
              "selector": "span"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        "selector": "ul.character__param div"
      },
      "attributes": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string"
            },
            "value": {
              "type": "number"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false
        },
        "selector": "table.character__param__list tr",
        "regex": "^(?<type>\\D+)(?<value>\\d+)"
      }
    },
    "required": [
      "name",
      "avatar",
      "server",
      "title",
      "bio",
      "identity",
      "nameday",
      "guardian",
      "citystate",
      "grand_company",
      "free_company",
      "pvp_team",
      "stats",
      "attributes"
    ],
    "additionalProperties": false
  }
}