{
  "classjob": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "selector": "div.character__job__name",
          "regex": "^([^[(]+)",
          "type": "string"
        },
        "level": {
          "type": "number",
          "selector": "div.character__job__level"
        },
        "exp": {
          "selector": "div.character__job__exp",
          "regex": "^(?<current>[\\d,. ]+) \\/ (?<max>[\\d,. ]+)",
          "type": "object",
          "properties": {
            "current": {
              "default": 0,
              "type": "number"
            },
            "max": {
              "default": 0,
              "type": "number"
            }
          },
          "required": [
            "current",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "level",
        "exp"
      ],
      "additionalProperties": false
    },
    "selector": "div.ldst__bg > div.character__job__role:nth-of-type(-n + 6) li"
  },
  "field_operations": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "selector": "div.character__job__name-sp"
        },
        "level": {
          "type": "number",
          "selector": "div.character__job__level"
        },
        "exp": {
          "selector": "div.character__job__exp",
          "regex": "^(?<current>[\\d,. ]+) \\/ (?<max>[\\d,. ]+)",
          "type": "object",
          "properties": {
            "current": {
              "default": 0,
              "type": "number"
            },
            "max": {
              "default": 0,
              "type": "number"
            }
          },
          "required": [
            "current",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "level",
        "exp"
      ],
      "additionalProperties": false
    },
    "selector": "div.ldst__bg > div.character__job__role:has(div.character__job__name-sp)"
  },
  "phantom_jobs": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "selector": "p.character__support_job__name"
        },
        "level": {
          "selector": "p.character__support_job__level",
          "regex": "(\\d+)",
          "type": "number"
        },
        "mastered": {
          "selector": "p.character__support_job__master",
          "type": "boolean"
        },
        "exp": {
          "selector": "p.character__support_job__exp",
          "regex": "^(?<current>[\\d,. ]+) \\/ (?<max>[\\d,. ]+)",
          "type": "object",
          "properties": {
            "current": {
              "type": "number"
            },
            "max": {
              "type": "number"
            }
          },
          "required": [
            "current",
            "max"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "name",
        "level"
      ],
      "additionalProperties": false
    },
    "selector": "div.character__support_job li"
  }
}