{
  "members": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "selector": "a.entry__bg",
          "attribute": "href",
          "regex": "(\\d+)",
          "type": "string"
        },
        "name": {
          "type": "string",
          "selector": "p.entry__name"
        },
        "avatar": {
          "type": "string",
          "format": "uri",
          "selector": "div.entry__chara__face > img",
          "attribute": "src"
        },
        "server": {
          "selector": "p.entry__world",
          "type": "object",
          "properties": {
            "world": {
              "type": "string"
            },
            "dc": {
              "type": "string"
            }
          },
          "required": [
            "world",
            "dc"
          ],
          "additionalProperties": false
        },
        "rank": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "selector": "div.entry__chara_info__linkshell > span"
                },
                "icon": {
                  "type": "string",
                  "format": "uri",
                  "selector": "div.entry__chara_info__linkshell > img",
                  "attribute": "src"
                }
              },
              "required": [
                "name",
                "icon"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "grand_company": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "selector": "li.js__tooltip",
                  "attribute": "data-tooltip",
                  "type": "string"
                },
                "rank": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "selector": "li.js__tooltip",
                      "attribute": "data-tooltip",
                      "type": "string"
                    },
                    "icon": {
                      "type": "string",
                      "format": "uri",
                      "selector": "li.js__tooltip > img",
                      "attribute": "src"
                    }
                  },
                  "required": [
                    "name",
                    "icon"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "rank"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "free_company": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "selector": "a.entry__freecompany__link",
                  "attribute": "href",
                  "regex": "(\\d+)",
                  "type": "string"
                },
                "name": {
                  "type": "string",
                  "selector": "a.entry__freecompany__link > span"
                },
                "crest": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uri"
                  },
                  "selector": "a.entry__freecompany__link img",
                  "attribute": "src"
                }
              },
              "required": [
                "id",
                "name",
                "crest"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "avatar",
        "server",
        "rank",
        "grand_company",
        "free_company"
      ],
      "additionalProperties": false
    },
    "selector": "div.ls__member > div.entry"
  },
  "profile": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "selector": "h3.heading__linkshell__name"
      },
      "server": {
        "selector": "div.ls__member > div.entry:first-of-type p.entry__world",
        "type": "object",
        "properties": {
          "world": {
            "type": "string"
          },
          "dc": {
            "type": "string"
          }
        },
        "required": [
          "world",
          "dc"
        ],
        "additionalProperties": false
      }
    },
    "required": [
      "name",
      "server"
    ],
    "additionalProperties": false
  }
}