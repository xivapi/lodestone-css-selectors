{
  "pagination": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "total": {
        "selector": "div.parts__fraction",
        "regex": "(\\d+)",
        "type": "number"
      },
      "next": {
        "selector": "div.btn__next > a",
        "regex": "(\\d+)",
        "type": "number"
      }
    },
    "required": [
      "total",
      "next"
    ],
    "additionalProperties": false
  }
}