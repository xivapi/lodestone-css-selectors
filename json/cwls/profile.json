{
  "members": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "selector": "a.cf-member-list",
          "attribute": "href",
          "regex": "(\\d+)",
          "type": "string"
        },
        "name": {
          "type": "string",
          "selector": "p.entry__name"
        },
        "avatar": {
          "type": "string",
          "format": "uri",
          "selector": "div.entry__chara__face > img",
          "attribute": "src"
        },
        "server": {
          "selector": "p.entry__world",
          "type": "object",
          "properties": {
            "world": {
              "type": "string"
            },
            "dc": {
              "type": "string"
            }
          },
          "required": [
            "world",
            "dc"
          ],
          "additionalProperties": false
        },
        "rank": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "selector": "li.entry__chara_info__linkshell > span"
                },
                "icon": {
                  "type": "string",
                  "format": "uri",
                  "selector": "li.entry__chara_info__linkshell > img",
                  "attribute": "src"
                }
              },
              "required": [
                "name",
                "icon"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "avatar",
        "server",
        "rank"
      ],
      "additionalProperties": false
    },
    "selector": "div.linkshell_characters div.entry__bg"
  },
  "profile": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "selector": "p.frame__cwls__name"
      },
      "server": {
        "type": "object",
        "properties": {
          "dc": {
            "type": "string",
            "selector": "span.frame__cwls__world"
          }
        },
        "required": [
          "dc"
        ],
        "additionalProperties": false
      },
      "formed_at": {
        "selector": "span.frame__cwls__formed > script",
        "regex": "ldst_strftime\\((\\d+)",
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "name",
      "server",
      "formed_at"
    ],
    "additionalProperties": false
  }
}