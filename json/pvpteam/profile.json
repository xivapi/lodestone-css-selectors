{
  "members": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "array",
    "items": {
      "type": "object",
      "properties": {
        "id": {
          "selector": "a.entry__bg",
          "attribute": "href",
          "regex": "(\\d+)",
          "type": "string"
        },
        "name": {
          "type": "string",
          "selector": "p.entry__name"
        },
        "avatar": {
          "type": "string",
          "format": "uri",
          "selector": "div.entry__chara__face > img",
          "attribute": "src"
        },
        "server": {
          "selector": "p.entry__world",
          "type": "object",
          "properties": {
            "world": {
              "type": "string"
            },
            "dc": {
              "type": "string"
            }
          },
          "required": [
            "world",
            "dc"
          ],
          "additionalProperties": false
        },
        "rank": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "selector": "ul.entry__freecompany__info:not(:has(li:first-of-type > i.list__ic__class)) > li:first-of-type > span"
                },
                "icon": {
                  "type": "string",
                  "format": "uri",
                  "selector": "ul.entry__freecompany__info:not(:has(li:first-of-type > i.list__ic__class)) > li:first-of-type > img",
                  "attribute": "src"
                }
              },
              "required": [
                "name",
                "icon"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "grand_company": {
          "default": null,
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "name": {
                  "selector": "li.js__tooltip",
                  "attribute": "data-tooltip",
                  "type": "string"
                },
                "rank": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "selector": "li.js__tooltip",
                      "attribute": "data-tooltip",
                      "type": "string"
                    },
                    "icon": {
                      "type": "string",
                      "format": "uri",
                      "selector": "li.js__tooltip > img",
                      "attribute": "src"
                    }
                  },
                  "required": [
                    "name",
                    "icon"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "name",
                "rank"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "matches": {
          "default": 0,
          "selector": "ul.entry__freecompany__info > li:last-of-type > span",
          "type": "number"
        }
      },
      "required": [
        "id",
        "name",
        "avatar",
        "server",
        "rank",
        "grand_company",
        "matches"
      ],
      "additionalProperties": false
    },
    "selector": "div.pvpteam__member > div.entry"
  },
  "profile": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "selector": "h2.entry__pvpteam__name--team"
      },
      "server": {
        "type": "object",
        "properties": {
          "dc": {
            "type": "string",
            "selector": "p.entry__pvpteam__name--dc"
          }
        },
        "required": [
          "dc"
        ],
        "additionalProperties": false
      },
      "crest": {
        "type": "array",
        "items": {
          "type": "string",
          "format": "uri"
        },
        "selector": "div.entry__pvpteam__crest img:not([class])",
        "attribute": "src"
      },
      "formed_at": {
        "selector": "span.entry__pvpteam__data--formed > script",
        "regex": "ldst_strftime\\((\\d+)",
        "type": "string",
        "format": "date-time"
      }
    },
    "required": [
      "name",
      "server",
      "crest",
      "formed_at"
    ],
    "additionalProperties": false
  }
}