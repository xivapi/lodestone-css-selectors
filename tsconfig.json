{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node16",
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "rootDir": ".",
    "types": ["node"],
    "lib": ["DOM"], // only for src/scripts/parser.ts
  },
  "include": ["**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
